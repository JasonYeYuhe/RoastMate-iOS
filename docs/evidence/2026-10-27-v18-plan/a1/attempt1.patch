+test("savage keeps a shape the unstyled draft lacks: a charge sheet, then a short verdict, in every script", () => {
+  // Plan v1.8 A1: the older "rapid, blunt charges" line produced Feral drafts
+  // a reader could not tell from the unstyled default (lens 1, 2026-10-27).
+  // The shape, not a swear-word count, is what makes the style recognisable.
+  const v = STYLE_VOICES.savage_no_filter;
+  assert.match(v.en, /charge sheet/);
+  assert.match(v.en, /starting with "you"/);
+  // The verdict is a few words, never one: the preview pilot (2026-10-27)
+  // ended both drafts on a bare 「王八蛋。」 / "Asshole.", a swear word as a
+  // sentence of its own, which the Feral rules forbid. The en line's
+  // "You're a …" shape held in the second pilot; zh still gave one word
+  // (「爛人。」) until the line named the frame 「你就是個……」.
+  assert.match(v.en, /3-6 word verdict on them, never one word/);
+  for (const voice of ["hans", "hant"]) {
+    assert.match(v[voice], /罪状|罪狀/, voice);
+    assert.match(v[voice], /用「你」开头|用「你」開頭/, voice);
+    assert.match(v[voice], /罪名要对得上|罪名要對得上/, voice);
+    assert.match(v[voice], /「你就是个……」|「你就是個……」/, voice);
+  }
+  assert.match(v.ja, /罪状/);
+  assert.match(v.ja, /「〜な人間だ」と、その行いに合う言葉で/);
+  // Every charge is something the situation says they did, never an added
+  // one: asked for "three or four", the first gate run padded with charges the
+  // user never wrote (「你坐视不管」, 「自分のことばかり話す」), and every
+  // zh-Hant draft ended on the same 「你就是個爛人。」 until the verdict had
+  // to fit the act.
+  assert.match(v.en, /actually did/);
+  for (const voice of ["hans", "hant"]) assert.match(v[voice], /不能自己加/, voice);
+  assert.match(v.ja, /状況に書かれた相手の行いだけ/);
+});
