+test("savage keeps a shape the unstyled draft lacks: a charge sheet, then a short verdict, in every script", () => {
+  // Plan v1.8 A1: the older "rapid, blunt charges" line produced Feral drafts
+  // a reader could not tell from the unstyled default (lens 1, 2026-10-27).
+  // The shape, not a swear-word count, is what makes the style recognisable.
+  const v = STYLE_VOICES.savage_no_filter;
+  assert.match(v.en, /charge sheet/);
+  assert.match(v.en, /starting with "you"/);
+  // The verdict is a few words, never one: the preview pilot (2026-10-27)
+  // ended both drafts on a bare 「王八蛋。」 / "Asshole.", a swear word as a
+  // sentence of its own, which the Feral rules forbid.
+  assert.match(v.en, /3-6 word verdict on them, never one word/);
+  for (const voice of ["hans", "hant"]) {
+    assert.match(v[voice], /罪状|罪狀/, voice);
+    assert.match(v[voice], /用「你」开头|用「你」開頭/, voice);
+    // Round 1 named the frame 「你就是個……」 and all three zh-Hant drafts
+    // ended on the same 「你就是個爛人。」: the verdict now comes from the
+    // person's role and act, and the catch-all word is named as off limits.
+    assert.match(v[voice], /罪名从他的身份和干的事来|罪名從他的身分和做的事來/, voice);
+    assert.match(v[voice], /不用「烂人」|不用「爛人」/, voice);
+    assert.doesNotMatch(v[voice], /你就是/, voice);
+  }
+  assert.match(v.ja, /罪状/);
+  assert.match(v.ja, /その人の立場と行いから選ぶ/);
+  assert.doesNotMatch(v.ja, /な人間だ/);
+  // Every charge is something the situation says they did, in the user's own
+  // words: round 1 padded charges the user never wrote (「你坐视不管」,
+  // 「自分のことばかり話す」), escalated 住院 to 病重, and added motive
+  // adverbs (偷偷, 假惺惺).
+  assert.match(v.en, /actually did/);
+  for (const voice of ["hans", "hant"]) {
+    assert.match(v[voice], /照情境原话|照情境原話/, voice);
+    assert.match(v[voice], /不加新事、不猜动机|不加新事、不猜動機/, voice);
+  }
+  assert.match(v.ja, /状況に書かれた言葉どおり/);
+  assert.match(v.ja, /動機の推測/);
+  // Round 1's zh drafts used semicolons; the line itself no longer has one.
+  for (const voice of ["hans", "hant", "ja"]) assert.doesNotMatch(v[voice], /[;；]/, voice);
+});
+
