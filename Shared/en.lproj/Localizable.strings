// MARK: - Onboarding

"onboarding.welcome.title" = "Say what you really mean.";
"onboarding.welcome.body" = "RoastMate turns frustration into witty, safe self-expression. Most modes run on Apple's on-device AI. Vent and Feral private drafts can use our cloud proxy for stronger output — but only after you explicitly allow it; until then they stay on-device.";

"onboarding.privacy.title" = "Private by design.";
"onboarding.privacy.body" = "Composed / Sharp / Savage and the Make-it-sendable rewrite run on-device with Apple's Foundation Models. Where that model isn't available, these modes and the rewrite show a clearly-marked example response instead; you are never charged for an example. Vent and Feral are written by a third-party LLM through our developer-owned cloud proxy — but only if you explicitly allow it; if you don't, they show clearly-marked examples. We never keep a copy either way. Your history syncs through your own iCloud account, which we cannot read. Review or revoke cloud permission anytime in Settings → AI & Privacy.";

"onboarding.safety.title" = "For self-expression, not harassment.";
"onboarding.safety.body" = "RoastMate is for venting your own feelings — not for targeting specific people. We strip names, threats, and slurs automatically.";
"onboarding.safety.acknowledge" = "I understand";

"ageGate.title" = "Mature humor ahead";
