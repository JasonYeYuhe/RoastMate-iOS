# macOS
.DS_Store

# Xcode — per-user state
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Xcode — build artifacts
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Swift Package Manager
.build/
.swiftpm/xcode/
Package.resolved

# CocoaPods (defensive — not currently used)
Pods/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Local env / secrets (defensive)
.env
.env.*
*.p12
*.cer
*.mobileprovision
AuthKey_*.p8

# Logs
*.log

# Cloud worker — node_modules + wrangler state should never be committed
cloud-worker/node_modules/
cloud-worker/.wrangler/
cloud-worker/dist/
# Catch-all: wrangler local cache wherever it lands (e.g. repo root)
.wrangler/

# iCloud/Finder-rename dups (do not track copies) — these also break xcodebuild
# (multiple .xcodeproj in the dir), so keep them ignored + delete when they appear
RoastMate [0-9]*.xcodeproj/
metadata/screenshots/iphone screenshots/
metadata/screenshots/mac screenshots /

# Claude Code local state (per-user; never commit)
.claude/
research/worker/.wrangler/

# Preflight Tier-A eval ephemeral outputs (date-prefixed eval reports
# under evals/runs/ stay tracked; the run-* subdirs are local-only).
evals/runs/run-*/
